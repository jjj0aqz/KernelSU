+        perm_error = avc_has_perm(&selinux_state, mysid, mysid, SECCLASS_PROCESS, PROCESS__SETCURRENT, NULL);
 #endif
-            return perm_error ?: error;
-        }
+        return perm_error ?: error;
     }
 
