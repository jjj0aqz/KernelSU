+/*
+ * Fixed time budget for app writes to attr/current, in nanoseconds. The
+ * handler below has to branch on the payload, and both the policy lookup and
+ * the original handler take measurably different routes depending on it.
+ * Holding the whole path to a constant budget keeps that from being
+ * observable. Writes to attr/current from app uids are rare, so the cost is
+ * irrelevant; raise this if a build ever shows residual jitter.
+ */
+#define KSU_SETPROC_PAD_NS 10000ULL
+
 typedef int (*setprocattr_fn)(const char *name, void *value, size_t size);
 static int __nocfi my_setprocattr(const char *name, void *value, size_t size)
 {
     int error, perm_error;
     u32 mysid, sid;
     char *str = value;
+    bool enforce;
+    const char *probe;
+    size_t probe_len;
+    u64 start = 0;
+    int ret;
